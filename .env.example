# ── Alpaca configuration ──────────────────────────────────────────────
# Copy this file to `.env` for local development (never commit the real .env!).
# On Render, set these in the dashboard: your service → "Environment" tab.

# REQUIRED: Alpaca API credentials (get them at https://app.alpaca.markets)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# REQUIRED: Alpaca trading base URL
#   Paper trading: https://paper-api.alpaca.markets
#   Live trading:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# OPTIONAL: Alpaca market-data base URL (defaults to https://data.alpaca.markets)
ALPACA_DATA_URL=https://data.alpaca.markets

# ── Optional integrations ────────────────────────────────────────────
# Optional: Finnhub key for fetching upcoming earnings tickers
FINNHUB_API_KEY=

# Optional: Polygon key for auto-detecting earnings dates
POLYGON_API_KEY=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
