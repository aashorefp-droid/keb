# Copy this file to `.env` for local development (never commit the real .env!).
# On Render, set these in the dashboard: your service → "Environment" tab.

# Primary market data source is Yahoo Finance (via yfinance) — no API key required!

# ── Optional integrations ────────────────────────────────────────────
# Optional: Polygon key for auto-detecting earnings dates
POLYGON_API_KEY=

# Optional: Finnhub key for fetching upcoming earnings tickers
FINNHUB_API_KEY=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional legacy fallback: Alpaca credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
